{
  "name": "react-native-glass-transitions",
  "version": "0.1.0",
  "type": "module",
  "description": "Liquid-glass theme transitions for React Native: any state change revealed by a refracting lens sweeping across the screen (Skia + Reanimated).",
  "license": "MIT",
  "author": {
    "name": "GeorgiLucasEdwin",
    "url": "https://github.com/GeorgiLucasEdwin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeorgiLucasEdwin/react-native-glass-transitions.git"
  },
  "homepage": "https://github.com/GeorgiLucasEdwin/react-native-glass-transitions#readme",
  "bugs": {
    "url": "https://github.com/GeorgiLucasEdwin/react-native-glass-transitions/issues"
  },
  "keywords": [
    "react-native",
    "ios",
    "expo",
    "skia",
    "reanimated",
    "animation",
    "transition",
    "theme",
    "dark-mode",
    "glass",
    "liquid-glass",
    "shader"
  ],
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./tuner": {
      "source": "./src/tuner.ts",
      "types": "./lib/typescript/tuner.d.ts",
      "default": "./lib/module/tuner.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/tests",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --no-warnings scripts/test.mjs",
    "build": "bob build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "prepare": "bob build",
    "example": "cd example && expo start --dev-client"
  },
  "peerDependencies": {
    "@expo/ui": ">=58.0.0",
    "@shopify/react-native-skia": ">=2.14.0",
    "expo-clipboard": ">=58.0.0",
    "expo-haptics": ">=58.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.88.0",
    "react-native-reanimated": ">=4.7.0",
    "react-native-worklets": ">=0.13.0"
  },
  "peerDependenciesMeta": {
    "@expo/ui": {
      "optional": true
    },
    "expo-clipboard": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@expo/ui": "58.0.29",
    "@shopify/react-native-skia": "2.14.0",
    "@types/node": "^22.15.0",
    "@types/react": "~19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo": "58.0.26",
    "expo-clipboard": "58.0.4",
    "expo-haptics": "58.0.8",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.43.2",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
