{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "target": "ESNext",
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "types": []
  },
  "include": ["src"]
}
